{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 py /d/tomes/harness-framework/.claude/hooks/context_freshness_gate.py",
            "statusMessage": "context freshness gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 py /d/tomes/harness-framework/.claude/hooks/answer_review_gate.py",
            "statusMessage": "answer-review gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qiE 'rm\\s+-[rRfF]*r|rm\\s+--recursive|git\\s+push\\s+(--force|-f\\b)|git\\s+reset\\s+--hard|git\\s+clean\\s+-[fdxX]+|git\\s+checkout\\s+--\\s*\\.|DROP\\s+TABLE|TRUNCATE\\s+TABLE|rmdir\\s+/[sS]|rd\\s+/[sS]|del\\s+/[fFsS]'; then echo 'BLOCKED: 위험한 명령어가 감지되었습니다.' >&2; exit 1; fi"
          }
        ]
      }
    ]
  }
}
