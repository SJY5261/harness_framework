+        Map<String, Object> lockMap = new HashMap<String, Object>();
+        lockMap.put("queryId", "orderMapper.acquireNumberingLock");
+        lockMap.put("LOCK_NAME", lockName);
+        Map<String, Object> resultMap = this.innodaleDao.getInfo(lockMap);
+        Object lockResult = resultMap != null ? resultMap.get("LOCK_RESULT") : null;
+        if (lockResult == null || ((Number) lockResult).longValue() != 1L) {
+            throw new ServiceNotValidException("채번 대기 시간이 초과되었습니다. 잠시 후 다시 시도해주세요.");
+        }
+        return true;
+    }
 
+    /**
+     * 네임드락 해제. finally에서 호출되므로 원래 예외를 덮지 않도록 실패해도 로그만 남긴다.
+     * (해제 누락 시 풀 커넥션에 락이 잔류하므로 반드시 finally로 호출할 것)
+     */
+    private void releaseNumberingLock(String lockName) {
+        try {
+            Map<String, Object> lockMap = new HashMap<String, Object>();
+            lockMap.put("queryId", "orderMapper.releaseNumberingLock");
+            lockMap.put("LOCK_NAME", lockName);
+            this.innodaleDao.getInfo(lockMap);
+        } catch (Exception e) {
+            log.error("releaseNumberingLock fail: " + lockName, e);
+        }
     }
 
 }
