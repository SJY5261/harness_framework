#!/bin/sh
set -eu

root="$(git rev-parse --show-toplevel)"
if command -v py >/dev/null 2>&1; then
    exec py -3 -X utf8 "$root/scripts/secret_guard.py" --staged
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/scripts/secret_guard.py" --staged
fi
if command -v python >/dev/null 2>&1; then
    exec python "$root/scripts/secret_guard.py" --staged
fi

echo "민감정보 검사를 실행할 Python을 찾지 못해 커밋을 차단합니다." >&2
exit 2
